# ==========================================
# Root .gitignore for Poultry Farm Project
# ==========================================

# ------------------------------------------
# Python & Backend
# ------------------------------------------
poultry/
**/poultry/
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database & SQLite files
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# Node.js & Frontend
# ------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Environment Files & Secrets (Never commit secrets)
# ------------------------------------------
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local

# Allow example configs
!.env.example
!**/.env.example
!.env.docker.example
!**/.env.docker.example

# ------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
