# ==========================================
# Docker Deployment Environment Variables
# ==========================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=poultry_db
POSTGRES_PORT=5432

# Application Ports
FRONTEND_PORT=80

# Security (Change in Production)
JWT_SECRET_KEY=poultry-super-secret-jwt-key-change-in-production-2026-secure
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMTP Email Configuration (Optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@poultryfarm.com

# Frontend URL
FRONTEND_URL=http://localhost
